@ARTICLE{NCARI95,
author={Audsley, N. and Burns, A. and Davis, R. and Tindell, K. and Wellings, A. },
title={Fixed priority pre-emptive scheduling: an historical
perspective},
journal={Real-Time Systems},
volume={8},
number={2-3},
pages={173-98},
year={1995},
annote={From its roots in job-shop scheduling, research into
fixed priority pre-emptive scheduling theory has
progressed from the artificial constraints and
simplistic assumptions used in early work to a
sufficient level of maturity that it is being
increasingly used in the implementation of real-time
systems. It is therefore appropriate that within this
special issue we provide an historical perspective on
the development of fixed priority pre-emptive
scheduling}
}

