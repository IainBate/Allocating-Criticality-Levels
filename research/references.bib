@INPROCEEDINGS{Smith1981,
  author = "J. Smith",
  year = 1981,
  title = "A {S}tudy of {B}ranch {P}rediction {S}trategies",
  booktitle = "8th International Symposium on Computer
              Architecture",
  address = "Minneapolis, Minnesota, USA",
  pages = "135--148",
  annotation = {In high-performance computer systems, performance losses due to
                conditional branch instructions can be minimized by predicting a
                branch outcome and fetching, decoding, and/or issuing subsequent
                instructions before the actual outcome is known. This paper
                discusses branch prediction strategies with the goal of
                maximizing prediction accuracy. First, currently used techniques
                are discussed and analyzed using instruction trace data. Then,
                new techniques are proposed and are shown to provide greater
                accuracy and more flexibility at low cost.}
}

