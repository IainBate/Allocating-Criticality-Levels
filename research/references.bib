@ARTICLE{S,
author={Tucker Taft, S.},
title={Ada 9X: a technical summary},
journal="Comms of the ACM",
volume={35},
number={11},
pages={77-82},
note={Commun. ACM (USA)},
annote={The Ada programming language, originally approved as an
ANSI/MIL standard in 1983 and an ISO standard in 1987,
is being revised in accordance with ANSI and ISO
procedures, with a 1993 target date for balloting on
the revised standard. The revised language is
currently designated 'Ada 9X' The major language
enhancements provided by Ada 9X are in the following
three areas: object-oriented programming; programming
in the large; and real-time and parallel programming.
In addition, Ada 9X generalizes the Ada 83 concept of
access types (pointer types) to allow them to point to
statistically allocated objects, as well as to
subprograms. Access-to-subprogram types are
particularly useful for implementing 'call-backs' as
used by a subsystem such as XWindows. Consistent with
the overall safety goals of Ada, these generalized
access types are associated with compile-time 'scope'
checks that prevent dangling references}
}

