@inproceedings{R:Tate:2009b,
author = {J. Tate and I. Bate},
title = {Understanding Behavioural Tradeoffs In Large-Scale Sensornet Design},
booktitle = {IEEE International Workshop on Quantitative Evaluation of Large-Scale Systems and Technologies},
year = {2009},
pages = {1085--1091},
month = {May},
abstract = {When designing a complex system such as a sensornet it is not always practical to build and deploy a realistically sized prototype. At the same time many of the interesting behaviours are hard to observe in small scale simulation and many of the current simulators do not scale well. In this paper we use present an efficient but effective simulator which, when combined with modern day large-scale computational capabilities, allow us to measure the impact of tuning an existing protocol and evaluate the necessary tradeoffs.}
}

@inproceedings{R:Tate:2009a_short,
author = {J. Tate and B. Woolford-Lim and I. Bate and X. Yao},
title = {Comparing Design Of Experiments and Evolutionary Approaches To Multi-Objective Optimisation Of Sensornet Protocols},
booktitle = {Proceedings of CEC},
year = {2009},
pages = {1137--1144},
abstract = {The lifespan, and hence utility, of sensornets is limited by the energy resources of individual motes. Network designers seek to maximise energy efficiency while maintaining an acceptable network Quality of Service. However, the interactions between multiple tunable protocol parameters and multiple sensornet performance metrics are generally complex and unknown. In this paper we address this multi-dimensional optimisation problem by two distinct approaches. Firstly, we apply a Design Of Experiments approach to obtain a generalised linear interaction model, and from this derive an estimated near-optimal solution. Secondly, we apply the Two-Archive evolutionary algorithm to improve solution quality for a specific problem instance. We demonstrate that, whereas the first approach yields a more generally applicable solution, the second approach yields a broader range of viable solutions at potentially lower experimental cost.}
}


@inproceedings{R:Tate:2009a,
author = {J. Tate and B. Woolford-Lim and I. Bate and X. Yao},
title = {Comparing Design Of Experiments and Evolutionary Approaches To Multi-Objective Optimisation Of Sensornet Protocols},
booktitle = {10th IEEE Congress on Evolutionary Computation},
year = {2009},
pages = {1137--1144},
abstract = {The lifespan, and hence utility, of sensornets is limited by the energy resources of individual motes. Network designers seek to maximise energy efficiency while maintaining an acceptable network Quality of Service. However, the interactions between multiple tunable protocol parameters and multiple sensornet performance metrics are generally complex and unknown. In this paper we address this multi-dimensional optimisation problem by two distinct approaches. Firstly, we apply a Design Of Experiments approach to obtain a generalised linear interaction model, and from this derive an estimated near-optimal solution. Secondly, we apply the Two-Archive evolutionary algorithm to improve solution quality for a specific problem instance. We demonstrate that, whereas the first approach yields a more generally applicable solution, the second approach yields a broader range of viable solutions at potentially lower experimental cost.}
}

@inproceedings{R:Tate:2009c,
author = {J. Tate and I. Bate},
title = {Energy Efficient Duty Allocation Protocols For Wireless Sensor Networks},
booktitle = {14th International IEEE Conference on Engineering of Complex Computer Systems},
year = {2009},
pages = {58--67},
abstract = {Wireless sensor networks require shared medium access management to prevent collisions, message corruption and other unhelpful effects. Cellular sensornets require minimal energy consumption to maximise network lifetime, and management of interaction with base stations and other cells. We present a protocol which dynamically generates a near-optimal duty schedule within a cell such that communication duty is shared evenly between participating nodes with exactly one node on-duty at any given time.}
}


